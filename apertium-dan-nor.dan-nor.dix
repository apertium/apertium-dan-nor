<pardef n="cgguess__np" c="For generating forms that were 'analysed' by CG ">
  <e>       <p><l><s n="np"/><s n="org"/><s n="cgguess"/></l> <r><s n="np"/><s n="org"/><s n="cgguess"/></r></p></e>
  <e>       <p><l><s n="np"/><s n="top"/><s n="cgguess"/></l> <r><s n="np"/><s n="top"/><s n="cgguess"/></r></p></e>
  <e>       <p><l><s n="np"/><s n="ant"/><s n="cgguess"/></l> <r><s n="np"/><s n="ant"/><s n="cgguess"/></r></p></e>
  <e>       <p><l><s n="np"/><s n="al"/><s n="cgguess"/></l>  <r><s n="np"/><s n="al"/><s n="cgguess"/></r></p></e>
  <e>       <p><l><s n="np"/><s n="attr"/><s n="cgguess"/></l><r><s n="np"/><s n="attr"/><s n="cgguess"/></r></p></e>
  <e>       <p><l><s n="np"/><s n="cog"/><s n="cgguess"/></l> <r><s n="np"/><s n="cog"/><s n="cgguess"/></r></p></e>
  <e>       <p><l><s n="np"/><s n="init"/><s n="cgguess"/></l><r><s n="np"/><s n="init"/><s n="cgguess"/></r></p></e>
  <e>       <p><l>-<s n="np"/><s n="cgguess"/></l>            <r>-<s n="np"/><s n="cgguess"/></r></p></e>
  <e>       <p><l><s n="np"/><s n="cgguess"/></l>             <r><s n="np"/><s n="cgguess"/></r></p></e>
</pardef>


<!-- Single letters – because of the many transitions here, use of this should be kept to small <section>'s -->
<pardef n="letter" c="will match both lowers and uppers. ONLY USE IN regex SECTION!">
  <e><re>[a-zæøåàáâãäçèéêëìíîïðñòóôõöùúûüýþāăąćčđēėęěğġīłńňŋōőœŕřśşšţťŧūűźżžǎǧǵǹșậỳ𝜇µßıA-ZÆØÅÀÁÂÃÄÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖÙÚÛÜÝÞĀĂĄĆČĐĒĖĘĚĞĠĪŁŃŇŊŌŐŒŔŘŚŞŠŢŤŦŪŰŹŻŽǍǦǴǸȘẬỲ𝛭Μß]</re></e>
</pardef>
<pardef n="upper" c="will only match uppers. ONLY USE IN regex SECTION!">
  <e><re>[A-ZÆØÅÀÁÂÃÄÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖÙÚÛÜÝÞĀĂĄĆČĐĒĖĘĚĞĠĪŁŃŇŊŌŐŒŔŘŚŞŠŢŤŦŪŰŹŻŽǍǦǴǸȘẬỲ𝛭Μß]</re></e>
</pardef>
<pardef n="letter+" c="will match both lowers and uppers. ONLY USE IN regex SECTION!">
  <e><re>[a-zæøåàáâãäçèéêëìíîïðñòóôõöùúûüýþāăąćčđēėęěğġīłńňŋōőœŕřśşšţťŧūűźżžǎǧǵǹșậỳ𝜇µßıA-ZÆØÅÀÁÂÃÄÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖÙÚÛÜÝÞĀĂĄĆČĐĒĖĘĚĞĠĪŁŃŇŊŌŐŒŔŘŚŞŠŢŤŦŪŰŹŻŽǍǦǴǸȘẬỲ𝛭Μß]+</re></e>
</pardef>
<pardef n="upper+" c="will only match uppers. ONLY USE IN regex SECTION!">
  <e><re>[A-ZÆØÅÀÁÂÃÄÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖÙÚÛÜÝÞĀĂĄĆČĐĒĖĘĚĞĠĪŁŃŇŊŌŐŒŔŘŚŞŠŢŤŦŪŰŹŻŽǍǦǴǸȘẬỲ𝛭Μß]+</re></e>
</pardef>
<pardef n="letterdash+" c="will match both lowers and uppers and dash. ONLY USE IN regex SECTION!">
  <e><re>[a-zæøåàáâãäçèéêëìíîïðñòóôõöùúûüýþāăąćčđēėęěğġīłńňŋōőœŕřśşšţťŧūűźżžǎǧǵǹșậỳ𝜇µßıA-ZÆØÅÀÁÂÃÄÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖÙÚÛÜÝÞĀĂĄĆČĐĒĖĘĚĞĠĪŁŃŇŊŌŐŒŔŘŚŞŠŢŤŦŪŰŹŻŽǍǦǴǸȘẬỲ𝛭Μß\-]+</re></e>
</pardef>
<pardef n="lowerdash+" c="will match lowers and dash. ONLY USE IN regex SECTION!">
  <e><re>[a-zæøåàáâãäçèéêëìíîïðñòóôõöùúûüýþāăąćčđēėęěğġīłńňŋōőœŕřśşšţťŧūűźżžǎǧǵǹșậỳ𝜇µßı𝛭Μß\-]+</re></e>
</pardef>

<pardef n="to-ti">
