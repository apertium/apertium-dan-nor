<dictionary>
<alphabet/>
<sdefs>
  <sdef n="n"         c="Noun"/>
  <sdef n="np"        c="Proper noun"/>
  <sdef n="prn"       c="Pronoun"/>
  <sdef n="adj"       c="Adjective"/>
  <sdef n="cnjcoo"    c=""/>
  <sdef n="cnjsub"    c=""/>
  <sdef n="neg"       c="negation"/>
  <sdef n="apos"      c="apostrophe"/>
  <sdef n="du"      c="dualis"/>
  <sdef n="pr"        c="Preposition"/>
  <sdef n="adv"       c="Adverb"/>
  <sdef n="vblex"     c="Verb"/>
  <sdef n="vaux"      c="Verb"/>
  <sdef n="vbmod"      c="Modal verb"/>
  <sdef n="vbser"      c="Verb 'to be'"/>
  <sdef n="vbhaver"   c="Verb 'to have'"/>
  <sdef n="part"  c="infinitive participle"/>
  <sdef n="ij"        c="Interjection"/>
  <sdef n="sg"     c="Singular"/>
  <sdef n="pl"     c="Plural"/>
  <sdef n="sp"     c="Singular / plural"/>
  <sdef n="unc"   c="Uncountable"/>
  <sdef n="det"     c="Determiner"/>
  <sdef n="pstv"  c="-s verbs"/>
  <sdef n="dem"     c="Demonstrative"/>
  <sdef n="acr"     c="acronym"/>
  <sdef n="emph"   c="Emphatic"/>
  <sdef n="ref"   c="Reflexive"/>
  <sdef n="rel"   c="Relative"/>
  <sdef n="res"   c="Reciprocal pronoun"/>
  <sdef n="pers"  c="Personal Pronoun"/>
  <sdef n="pos"     c="Possessive"/>
  <sdef n="itg"     c="Question word / interrogative"/>
  <sdef n="qnt"     c="Quantifier"/>
  <sdef n="ord"      c="Ordinal"/>
  <sdef n="def"      c="Definite"/>
  <sdef n="ind"      c="Indefinite"/>
  <sdef n="p1"      c="First person"/>
  <sdef n="p2"      c="Second person"/>
  <sdef n="p3"      c="Third person"/>

  <sdef n="sint"      c="Synthetic"/>

  <sdef n="top"   c="Toponym"/>
  <sdef n="ant"   c="Anthroponym"/>
  <sdef n="cog"   c="Cognomen"/>
  <sdef n="org"  c="Organisation"/>
  <sdef n="al"  c="Altres / misc proper nouns"/>
  <sdef n="attr"    c="Attributive (certain proper nouns)" />
  <sdef n="init"    c="Initials"/>


  <sdef n="un"        c="Common / neuter"/>
  <sdef n="m"        c="Masculine"/>
  <sdef n="f"        c="Feminine"/>
  <sdef n="ut"        c="Common"/>
  <sdef n="nt"        c="Neuter"/>
  <sdef n="mf"        c="Masculine / feminine"/>
  <sdef n="nom"   c="nominative"/>
  <sdef n="acc"   c="accusative"/>
  <sdef n="imp"   c="imperative"/>
  <sdef n="gen"   c="genitive"/>
  <sdef n="pst"       c="Positive degree"/>
  <sdef n="cnjadv"    c="Conjunction adverbs - Danish?"/>
  <sdef n="comp"      c="Comparative degree"/>
  <sdef n="sup"      c="Superlative degree"/>
  <sdef n="xpst"    c="Positive derivative"/>
  <sdef n="xpsts"   c="Positive derivative of synthetics"/>
  <sdef n="xpsto"   c="Positive derivative of ordinals"/>
  <sdef n="xcomp"   c="Comparative derivative"/>
  <sdef n="xsup"    c="Superlative derivative"/>

  <sdef n="inf"      c="Infinitive"/>
  <sdef n="pres"     c="Present tense"/>
  <sdef n="past"     c="Past tense (Danish)"/>
  <sdef n="pret"     c="Past tense (Bokmål)"/>
  <sdef n="actv"     c="Active voice"/>
  <sdef n="pasv"     c="Passive voice"/>
  <sdef n="pprs"      c="Present participle"/>
  <sdef n="pp"      c="Past participle"/>

  <sdef n="expl" 	c="Syntactic expletive / formal subject"/>

  <sdef n="cmp"     c="Compound-left-part"/>
  <sdef n="cmp-split" c="Split compound-left-part"/>

  <sdef n="guess" 	c="Guesser"/>
  <sdef n="cgguess" 	c="CG Guesser"/>
  <sdef n="url" 	c="URL/E-mail"/>

  <sdef n="sent"      c="Sentence boundary"/>
  <sdef n="cm"      c="Comma"/>
  <sdef n="clb"       c="Clause boundary"/>
  <sdef n="guio"      c="Dash" />
  <sdef n="lpar"    c="Left parenthesis" />
  <sdef n="rpar"    c="Right parenthesis" />
  <sdef n="lquot"   c="Left quotation mark"/>
  <sdef n="rquot"   c="Right quotation mark"/>

  <sdef n="remspc" c="Tell transfer to remove preceding space"/>
</sdefs>

<pardefs>


<!-- generate f for nno, m for nob; analyse both for both langs: -->
<pardef n=":f/m">
  <e vr="nob">        <p><l></l><r><s n="m"/></r></p></e>
  <e vr="nno">        <p><l></l><r><s n="f"/></r></p></e>
</pardef>

<pardef n="sgpl:sp" c="TODO: ND/DD">
  <e>       <p><l><s n="sg"/><s n="ind"/></l><r><s n="sp"/></r></p></e>
  <e r="LR"><p><l><s n="pl"/><s n="ind"/></l><r><s n="sp"/></r></p></e>
  <e r="LR"><p><l><s n="sg"/><s n="def"/></l><r><s n="sp"/></r></p></e>
  <e r="LR"><p><l><s n="pl"/><s n="def"/></l><r><s n="sp"/></r></p></e>
</pardef>
<pardef n="sp:sgpl" c="TODO: ND/DD">
  <e>       <p><l><s n="sp"/></l><r><s n="sg"/><s n="ind"/></r></p></e>
  <e r="RL"><p><l><s n="sp"/></l><r><s n="pl"/><s n="ind"/></r></p></e>
  <e r="RL"><p><l><s n="sp"/></l><r><s n="sg"/><s n="def"/></r></p></e>
  <e r="RL"><p><l><s n="sp"/></l><r><s n="pl"/><s n="def"/></r></p></e>
</pardef>
<pardef n="sgpl:sgpl" c="(to block the sp reading) TODO: ND/DD">
  <e>       <p><l><s n="sg"/></l><r><s n="sg"/></r></p></e>
  <e>       <p><l><s n="pl"/></l><r><s n="pl"/></r></p></e>
</pardef>

    <pardef n="@sgpl" c="restrict to sg/pl">
<e>         <p><l><s n="sg"/></l><r><s n="sg"/></r></p></e>
<e>         <p><l><s n="pl"/></l><r><s n="pl"/></r></p></e>
    </pardef>
    <pardef n="@sg" c="restrict to sg">
<e>         <p><l><s n="sg"/></l><r><s n="sg"/></r></p></e>
    </pardef>
    <pardef n="@pl" c="restrict to pl">
<e>         <p><l><s n="pl"/></l><r><s n="pl"/></r></p></e>
    </pardef>


<pardef n="n_acr" c="optional dot">
  <e>       <re>.?</re><p><l><s n="n"/><s n="acr"/></l><r><s n="n"/><s n="acr"/></r></p></e>
</pardef>


    <pardef n="n_cmp_only">
<e><p><l><s n="n"/><s n="m"/><s n="sg"/><s n="ind"/><s n="cmp"/></l><r><s n="n"/><s n="m"/><s n="sg"/><s n="ind"/><s n="cmp"/></r></p></e>
<e><p><l><s n="n"/><s n="m"/><s n="sg"/><s n="ind"/><s n="cmp-split"/></l><r><s n="n"/><s n="m"/><s n="sg"/><s n="ind"/><s n="cmp-split"/></r></p></e>
    </pardef>



<pardef n="__prn" c="TODO: GD?">
  <e r="RL"><p><l><s n="ut"/><s n="sg"/></l>   <r><s n="f"/><s n="sg"/></r></p></e>
  <e vr="nno"><p><l><s n="ut"/><s n="sg"/></l> <r><s n="m"/><s n="sg"/></r></p></e>
  <e vr="nob"><p><l><s n="ut"/><s n="sg"/></l> <r><s n="mf"/><s n="sg"/></r></p></e>
  <e>       <p><l><s n="nt"/><s n="sg"/></l>   <r><s n="nt"/><s n="sg"/></r></p></e>
  <e>       <p><l><s n="un"/><s n="pl"/></l>   <r><s n="un"/><s n="pl"/></r></p></e>
</pardef>

<!-- determinatives -->
  <pardef n="det+prn_pos" c="TODO: GD? (nno)">
<e>         <p><l><s n="prn"/><s n="pos"/></l>            <r><s n="prn"/><s n="pos"/></r></p></e>
<e vr="nno"><p><l><s n="prn"/><s n="pos"/><s n="ut"/></l> <r><s n="prn"/><s n="pos"/><s n="f"/></r></p></e>
<e>         <p><l><s n="prn"/><s n="pos"/><s n="ut"/></l> <r><s n="prn"/><s n="pos"/><s n="m"/></r></p></e>
<e>         <p><l><s n="det"/><s n="pos"/></l>            <r><s n="det"/><s n="pos"/></r></p></e>
<e vr="nno"><p><l><s n="det"/><s n="pos"/><s n="ut"/></l> <r><s n="det"/><s n="pos"/><s n="f"/></r></p></e>
<e>         <p><l><s n="det"/><s n="pos"/><s n="ut"/></l> <r><s n="det"/><s n="pos"/><s n="m"/></r></p></e>
  </pardef>

<pardef n="__det" c="TODO: GD?">
  <e r="RL"><p><l><s n="ut"/><s n="sg"/></l>   <r><s n="f"/><s n="sg"/></r></p></e>
  <e>       <p><l><s n="ut"/><s n="sg"/></l>   <r><s n="m"/><s n="sg"/></r></p></e>
  <e>       <p><l><s n="nt"/><s n="sg"/></l>   <r><s n="nt"/><s n="sg"/></r></p></e>
  <e>       <p><l><s n="un"/><s n="pl"/></l>   <r><s n="un"/><s n="pl"/></r></p></e>
</pardef>
<pardef n="pl:__det" c="TODO: GD?">
  <e r="RL"><p><l><s n="un"/><s n="pl"/></l>   <r><s n="f"/><s n="sg"/></r></p></e>
  <e r="RL"><p><l><s n="un"/><s n="pl"/></l>   <r><s n="m"/><s n="sg"/></r></p></e>
  <e r="RL"><p><l><s n="un"/><s n="pl"/></l>   <r><s n="nt"/><s n="sg"/></r></p></e>
  <e>       <p><l><s n="un"/><s n="pl"/></l>   <r><s n="un"/><s n="pl"/></r></p></e>
</pardef>
<pardef n="sp:sg__det" c="TODO: GD?">
  <e r="RL"><p><l><s n="un"/><s n="sp"/></l>   <r><s n="f"/><s n="sg"/></r></p></e>
  <e>       <p><l><s n="un"/><s n="sp"/></l>   <r><s n="m"/><s n="sg"/></r></p></e>
  <e>       <p><l><s n="nt"/><s n="sg"/></l>   <r><s n="nt"/><s n="sg"/></r></p></e>
</pardef>
<pardef n="sp__det" c="TODO: GD?">
  <e r="RL"><p><l><s n="ut"/><s n="sp"/></l>   <r><s n="f"/><s n="sp"/></r></p></e>
  <e>       <p><l><s n="ut"/><s n="sp"/></l>   <r><s n="m"/><s n="sp"/></r></p></e>
  <e>       <p><l><s n="nt"/><s n="sp"/></l>   <r><s n="nt"/><s n="sp"/></r></p></e>
</pardef>
<pardef n=":pl__det">
  <e r="LR"><p><l><s n="ut"/><s n="sg"/></l>   <r><s n="un"/><s n="pl"/></r></p></e>
  <e r="LR"><p><l><s n="nt"/><s n="sg"/></l>   <r><s n="un"/><s n="pl"/></r></p></e>
  <e>       <p><l><s n="un"/><s n="pl"/></l>   <r><s n="un"/><s n="pl"/></r></p></e>
</pardef>

<pardef n="acc_gen:gen" c="unmarked in nor is acc">
  <e r="LR"><p><l><s n="nom"/></l><r></r></p></e>
  <e>       <p><l><s n="acc"/></l><r></r></p></e>
  <e>       <p><l><s n="gen"/></l><r><s n="gen"/></r></p></e>
</pardef>
<pardef n="nom_gen:gen" c="unmarked in nor is nom">
  <e>       <p><l><s n="nom"/></l><r></r></p></e>
  <e r="LR"><p><l><s n="acc"/></l><r></r></p></e>
  <e>       <p><l><s n="gen"/></l><r><s n="gen"/></r></p></e>
</pardef>

<!-- Verbs -->
    <pardef n="vblex">
<e>       <p><l><s n="vblex"/><s n="past"/><s n="pasv"/></l>   <r><s n="vblex"/><s n="pret"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pres"/><s n="pasv"/></l>   <r><s n="vblex"/><s n="pres"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="inf"/><s n="pasv"/></l>    <r><s n="vblex"/><s n="inf"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="past"/><s n="actv"/></l>   <r><s n="vblex"/><s n="pret"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pres"/><s n="actv"/></l>   <r><s n="vblex"/><s n="pres"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="inf"/><s n="actv"/></l>    <r><s n="vblex"/><s n="inf"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="imp"/></l>                 <r><s n="vblex"/><s n="imp"/></r></p></e>
<e>       <p><l><s n="adj"/><s n="pprs"/></l>                  <r><s n="adj"/><s n="pprs"/></r></p></e>
<e>       <p><l><s n="adj"/><s n="pp"/></l>                    <r><s n="adj"/><s n="pp"/></r></p></e>
<e>       <p><l><s n="adj"/><s n="pp"/><s n="ut"/></l>         <r><s n="adj"/><s n="pp"/><s n="mf"/></r></p></e>
<e r="RL">  <p><l><s n="adj"/><s n="pp"/><s n="ut"/></l>         <r><s n="adj"/><s n="pp"/><s n="f"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pp"/></l>                  <r><s n="vblex"/><s n="pp"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pp"/><s n="ut"/></l>       <r><s n="vblex"/><s n="pp"/><s n="mf"/></r></p></e>
<e r="RL">  <p><l><s n="vblex"/><s n="pp"/><s n="ut"/></l>       <r><s n="vblex"/><s n="pp"/><s n="f"/></r></p></e>
    </pardef>

    <pardef n="vbhaver:vblex">
<e>       <p><l><s n="vbhaver"/><s n="past"/><s n="pasv"/></l> <r><s n="vblex"/><s n="pret"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vbhaver"/><s n="pres"/><s n="pasv"/></l> <r><s n="vblex"/><s n="pres"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vbhaver"/><s n="inf"/><s n="pasv"/></l>  <r><s n="vblex"/><s n="inf"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vbhaver"/><s n="past"/><s n="actv"/></l> <r><s n="vblex"/><s n="pret"/></r></p></e>
<e>       <p><l><s n="vbhaver"/><s n="pres"/><s n="actv"/></l> <r><s n="vblex"/><s n="pres"/></r></p></e>
<e>       <p><l><s n="vbhaver"/><s n="inf"/><s n="actv"/></l>  <r><s n="vblex"/><s n="inf"/></r></p></e>
<e>       <p><l><s n="vbhaver"/><s n="imp"/></l>               <r><s n="vblex"/><s n="imp"/></r></p></e>
<e>       <p><l><s n="adj"/><s n="pprs"/></l>                  <r><s n="adj"/><s n="pprs"/></r></p></e>
<e>       <p><l><s n="adj"/><s n="pp"/></l>                    <r><s n="adj"/><s n="pp"/></r></p></e>
<e>       <p><l><s n="adj"/><s n="pp"/><s n="ut"/></l>         <r><s n="adj"/><s n="pp"/><s n="mf"/></r></p></e>
<e r="RL">  <p><l><s n="adj"/><s n="pp"/><s n="ut"/></l>         <r><s n="adj"/><s n="pp"/><s n="f"/></r></p></e>
<e>       <p><l><s n="vbhaver"/><s n="pp"/></l>                <r><s n="vblex"/><s n="pp"/></r></p></e>
<e>       <p><l><s n="vbhaver"/><s n="pp"/><s n="ut"/></l>     <r><s n="vblex"/><s n="pp"/><s n="mf"/></r></p></e>
<e r="RL">  <p><l><s n="vbhaver"/><s n="pp"/><s n="ut"/></l>     <r><s n="vblex"/><s n="pp"/><s n="f"/></r></p></e>
    </pardef>

    <pardef n="vbser:vblex">
<e>       <p><l><s n="vbser"/><s n="past"/><s n="pasv"/></l>   <r><s n="vblex"/><s n="pret"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vbser"/><s n="pres"/><s n="pasv"/></l>   <r><s n="vblex"/><s n="pres"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vbser"/><s n="inf"/><s n="pasv"/></l>    <r><s n="vblex"/><s n="inf"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vbser"/><s n="past"/><s n="actv"/></l>   <r><s n="vblex"/><s n="pret"/></r></p></e>
<e>       <p><l><s n="vbser"/><s n="pres"/><s n="actv"/></l>   <r><s n="vblex"/><s n="pres"/></r></p></e>
<e>       <p><l><s n="vbser"/><s n="inf"/><s n="actv"/></l>    <r><s n="vblex"/><s n="inf"/></r></p></e>
<e>       <p><l><s n="vbser"/><s n="imp"/></l>                 <r><s n="vblex"/><s n="imp"/></r></p></e>
<e>       <p><l><s n="adj"/><s n="pprs"/></l>                  <r><s n="adj"/><s n="pprs"/></r></p></e>
<e>       <p><l><s n="adj"/><s n="pp"/></l>                    <r><s n="adj"/><s n="pp"/></r></p></e>
<e>       <p><l><s n="adj"/><s n="pp"/><s n="ut"/></l>         <r><s n="adj"/><s n="pp"/><s n="mf"/></r></p></e>
<e r="RL">  <p><l><s n="adj"/><s n="pp"/><s n="ut"/></l>         <r><s n="adj"/><s n="pp"/><s n="f"/></r></p></e>
<e>       <p><l><s n="vbser"/><s n="pp"/></l>                  <r><s n="vblex"/><s n="pp"/></r></p></e>
<e>       <p><l><s n="vbser"/><s n="pp"/><s n="ut"/></l>       <r><s n="vblex"/><s n="pp"/><s n="mf"/></r></p></e>
<e r="RL">  <p><l><s n="vbser"/><s n="pp"/><s n="ut"/></l>       <r><s n="vblex"/><s n="pp"/><s n="f"/></r></p></e>
    </pardef>

    <pardef n="vbmod:vblex">
<e>       <p><l><s n="vbmod"/><s n="past"/><s n="pasv"/></l>   <r><s n="vblex"/><s n="pret"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vbmod"/><s n="pres"/><s n="pasv"/></l>   <r><s n="vblex"/><s n="pres"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vbmod"/><s n="inf"/><s n="pasv"/></l>    <r><s n="vblex"/><s n="inf"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vbmod"/><s n="past"/><s n="actv"/></l>   <r><s n="vblex"/><s n="pret"/></r></p></e>
<e>       <p><l><s n="vbmod"/><s n="pres"/><s n="actv"/></l>   <r><s n="vblex"/><s n="pres"/></r></p></e>
<e>       <p><l><s n="vbmod"/><s n="inf"/><s n="actv"/></l>    <r><s n="vblex"/><s n="inf"/></r></p></e>
<e>       <p><l><s n="vbmod"/><s n="imp"/></l>                 <r><s n="vblex"/><s n="imp"/></r></p></e>
<e>       <p><l><s n="adj"/><s n="pprs"/></l>                  <r><s n="adj"/><s n="pprs"/></r></p></e>
<e>       <p><l><s n="adj"/><s n="pp"/></l>                    <r><s n="adj"/><s n="pp"/></r></p></e>
<e>       <p><l><s n="adj"/><s n="pp"/><s n="ut"/></l>         <r><s n="adj"/><s n="pp"/><s n="mf"/></r></p></e>
<e r="RL">  <p><l><s n="adj"/><s n="pp"/><s n="ut"/></l>         <r><s n="adj"/><s n="pp"/><s n="f"/></r></p></e>
<e>       <p><l><s n="vbmod"/><s n="pp"/></l>                  <r><s n="vblex"/><s n="pp"/></r></p></e>
<e>       <p><l><s n="vbmod"/><s n="pp"/><s n="ut"/></l>       <r><s n="vblex"/><s n="pp"/><s n="mf"/></r></p></e>
<e r="RL">  <p><l><s n="vbmod"/><s n="pp"/><s n="ut"/></l>       <r><s n="vblex"/><s n="pp"/><s n="f"/></r></p></e>
    </pardef>

    <pardef n="vaux:vblex">
<e>       <p><l><s n="vaux"/><s n="past"/><s n="pasv"/></l> <r><s n="vblex"/><s n="pret"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vaux"/><s n="pres"/><s n="pasv"/></l> <r><s n="vblex"/><s n="pres"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vaux"/><s n="inf"/><s n="pasv"/></l>  <r><s n="vblex"/><s n="inf"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vaux"/><s n="past"/><s n="actv"/></l> <r><s n="vblex"/><s n="pret"/></r></p></e>
<e>       <p><l><s n="vaux"/><s n="pres"/><s n="actv"/></l> <r><s n="vblex"/><s n="pres"/></r></p></e>
<e>       <p><l><s n="vaux"/><s n="inf"/><s n="actv"/></l>  <r><s n="vblex"/><s n="inf"/></r></p></e>
<e>       <p><l><s n="vaux"/><s n="imp"/></l>               <r><s n="vblex"/><s n="imp"/></r></p></e>
<e>       <p><l><s n="adj"/><s n="pprs"/></l>               <r><s n="adj"/><s n="pprs"/></r></p></e>
<e>       <p><l><s n="adj"/><s n="pp"/></l>                 <r><s n="adj"/><s n="pp"/></r></p></e>
<e>       <p><l><s n="adj"/><s n="pp"/><s n="ut"/></l>      <r><s n="adj"/><s n="pp"/><s n="mf"/></r></p></e>
<e r="RL">  <p><l><s n="adj"/><s n="pp"/><s n="ut"/></l>      <r><s n="adj"/><s n="pp"/><s n="f"/></r></p></e>
<e>       <p><l><s n="vaux"/><s n="pp"/></l>                <r><s n="vblex"/><s n="pp"/></r></p></e>
<e>       <p><l><s n="vaux"/><s n="pp"/><s n="ut"/></l>     <r><s n="vblex"/><s n="pp"/><s n="mf"/></r></p></e>
<e r="RL">  <p><l><s n="vaux"/><s n="pp"/><s n="ut"/></l>     <r><s n="vblex"/><s n="pp"/><s n="f"/></r></p></e>
    </pardef>

    <pardef n="pass:pstv" c="Note: unless the translation using this paradigm is RL,
                             you also need to specify additional LR adj.pp/adj.pprs entries">
<e r="LR"><p><l><s n="vblex"/><s n="inf"/><s n="actv"/></l>      <r><s n="vblex"/><s n="pstv"/><s n="inf"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="inf"/><s n="pasv"/></l>      <r><s n="vblex"/><s n="pstv"/><s n="inf"/></r></p></e>
<e r="LR"><p><l><s n="vblex"/><s n="pres"/><s n="actv"/></l>     <r><s n="vblex"/><s n="pstv"/><s n="pres"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pres"/><s n="pasv"/></l>     <r><s n="vblex"/><s n="pstv"/><s n="pres"/></r></p></e>
<!-- these next are not ideal... could put a reflexive in there with a
     transfer rule or something, not sure what would work most
     generally though: -->
<e r="LR"><p><l><s n="vblex"/><s n="past"/><s n="actv"/></l>     <r><s n="vblex"/><s n="pstv"/><s n="pret"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="past"/><s n="pasv"/></l>     <r><s n="vblex"/><s n="pstv"/><s n="pret"/></r></p></e>
<e r="LR"><p><l><s n="vblex"/><s n="imp"/></l>      <r><s n="vblex"/><s n="pstv"/><s n="inf"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pp"/></l>                    <r><s n="vblex"/><s n="pstv"/><s n="pp"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pp"/><s n="ut"/></l>         <r><s n="vblex"/><s n="pstv"/><s n="pp"/><s n="mf"/></r></p></e>
<e r="RL">  <p><l><s n="vblex"/><s n="pp"/><s n="ut"/></l>         <r><s n="vblex"/><s n="pstv"/><s n="pp"/><s n="f"/></r></p></e>
    </pardef>

    <pardef n="vbser:pstv" c="no adj entries (trimmed out)">
<e>         <p><l><s n="vbser"/><s n="inf"/><s n="actv"/></l>      <r><s n="vblex"/><s n="pstv"/><s n="inf"/></r></p></e>
<e r="LR">  <p><l><s n="vbser"/><s n="inf"/><s n="pasv"/></l>      <r><s n="vblex"/><s n="pstv"/><s n="inf"/></r></p></e>
<e>         <p><l><s n="vbser"/><s n="pres"/><s n="actv"/></l>     <r><s n="vblex"/><s n="pstv"/><s n="pres"/></r></p></e>
<e r="LR">  <p><l><s n="vbser"/><s n="pres"/><s n="pasv"/></l>     <r><s n="vblex"/><s n="pstv"/><s n="pres"/></r></p></e>
<e>         <p><l><s n="vbser"/><s n="past"/><s n="actv"/></l>     <r><s n="vblex"/><s n="pstv"/><s n="pret"/></r></p></e>
<e r="LR">  <p><l><s n="vbser"/><s n="past"/><s n="pasv"/></l>     <r><s n="vblex"/><s n="pstv"/><s n="pret"/></r></p></e>
<e r="LR"><p><l><s n="vbser"/><s n="imp"/></l>      <r><s n="vblex"/><s n="inf"/></r></p></e>
<e>       <p><l><s n="vbser"/><s n="pp"/></l>                    <r><s n="vblex"/><s n="pstv"/><s n="pp"/></r></p></e>
    </pardef>

    <pardef n="pstv:actv" c="for translating nob active to dan pstv (transfer has to deal with reordering, expl-insertion and nom2acc of agent)">
<e>       <p><l><s n="vblex"/><s n="pstv"/><s n="inf"/><s n="actv"/></l>  <r><s n="vblex"/><s n="inf"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pstv"/><s n="inf"/><s n="pasv"/></l>  <r><s n="vblex"/><s n="inf"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pstv"/><s n="pres"/><s n="actv"/></l> <r><s n="vblex"/><s n="pres"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pstv"/><s n="pres"/><s n="pasv"/></l> <r><s n="vblex"/><s n="pres"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pstv"/><s n="past"/><s n="actv"/></l> <r><s n="vblex"/><s n="pret"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pstv"/><s n="past"/><s n="pasv"/></l> <r><s n="vblex"/><s n="pret"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pstv"/><s n="imp"/></l>               <r><s n="vblex"/><s n="imp"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pstv"/><s n="pp"/></l>                <r><s n="vblex"/><s n="pp"/></r></p></e>
    </pardef>

    <pardef n="pstv" c="for when both sides are pstv (no adj/pass forms)">
<e>       <p><l><s n="vblex"/><s n="past"/><s n="actv"/></l> <r><s n="vblex"/><s n="pstv"/><s n="pret"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pres"/><s n="actv"/></l> <r><s n="vblex"/><s n="pstv"/><s n="pres"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="inf"/><s n="actv"/></l>  <r><s n="vblex"/><s n="pstv"/><s n="inf"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pp"/></l>                <r><s n="vblex"/><s n="pstv"/><s n="pp"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pp"/><s n="ut"/></l>     <r><s n="vblex"/><s n="pstv"/><s n="pp"/><s n="mf"/></r></p></e>
<e r="RL">  <p><l><s n="vblex"/><s n="pp"/><s n="ut"/></l>     <r><s n="vblex"/><s n="pstv"/><s n="pp"/><s n="f"/></r></p></e>
    </pardef>

    <pardef n="cas:" c="just strip the dan case">
<e r="LR">  <p><l><s n="gen"/></l><r></r></p></e>
<e>         <p><l></l><r></r></p></e>
<e>       <p><l>NON_ANALYSIS</l>          <r>DUE_TO_LT_PROC_HANG</r></p></e>
    </pardef>

    <pardef n=":cas" c="just strip the nor case">
<e r="RL">  <p><l></l><r><s n="gen"/></r></p></e>
<e>         <p><l></l><r></r></p></e>
<e>       <p><l>NON_ANALYSIS</l>          <r>DUE_TO_LT_PROC_HANG</r></p></e>
    </pardef>

    <pardef n="adjgrad" c="Used by adj pardefs">
      <!-- slik at me kan ha
           foo<adj><pp> <=> bar<adj><pp>
           medan
           foo<adj><posi> <=> bum<adj><posi> -->
<e>       <p><l><s n="comp"/></l> <r><s n="comp"/></r></p></e>
<e>       <p><l><s n="pst"/></l> <r><s n="pst"/></r></p></e>
<e>       <p><l><s n="pst"/><s n="ut"/><s n="sg"/><s n="ind"/></l> <r><s n="pst"/><s n="mf"/><s n="sg"/><s n="ind"/></r></p></e>
<e r="RL"><p><l><s n="pst"/><s n="ut"/><s n="sg"/><s n="ind"/></l> <r><s n="pst"/><s n="f"/><s n="sg"/><s n="ind"/></r></p></e>
<e>       <p><l><s n="pst"/><s n="un"/><s n="sp"/><s n="def"/></l> <r><s n="pst"/><s n="un"/><s n="sp"/><s n="def"/></r></p></e>
<e>       <p><l><s n="sup"/></l>  <r><s n="sup"/></r></p></e>
    </pardef>
    <pardef n="n.adjgrad" c="Used by adj pardefs for including genitive nominalisations of adj's">
<e>       <p><l><s n="n"/><s n="xcomp"/></l> <r><s n="n"/><s n="xcomp"/></r></p></e>
<e>       <p><l><s n="n"/><s n="xpst"/></l>  <r><s n="n"/><s n="xpst"/></r></p></e>
<e>       <p><l><s n="n"/><s n="xpsts"/></l> <r><s n="n"/><s n="xpsts"/></r></p></e>
<e>       <p><l><s n="n"/><s n="xpsto"/></l> <r><s n="n"/><s n="xpsto"/></r></p></e>
<e>       <p><l><s n="n"/><s n="xsup"/></l>  <r><s n="n"/><s n="xsup"/></r></p></e>
    </pardef>

    <pardef n="adj" c="Non-verbal forms of adj">
<e>       <p><l><s n="adj"/></l>              <r><s n="adj"/></r></p><par n="adjgrad"/></e>
<e>       <par n="n.adjgrad"/></e>
    </pardef>

    <pardef n="adj_sint" c="synthetic on both sides">
<e>       <p><l><s n="adj"/><s n="sint"/></l> <r><s n="adj"/><s n="sint"/></r></p><par n="adjgrad"/></e>
<e>       <par n="n.adjgrad"/></e>
    </pardef>
    <pardef n="adj_sint:adj" c="synthetic on dan side; xpsts:xpst and let transfer deal with xcomp/xsup">
<e>       <p><l><s n="adj"/><s n="sint"/></l> <r><s n="adj"/></r></p><par n="adjgrad"/></e>
<e>       <p><l><s n="n"/><s n="xcomp"/></l> <r><s n="n"/><s n="xcomp"/></r></p></e>
<e>       <p><l><s n="n"/><s n="xpsts"/></l> <r><s n="n"/><s n="xpst"/></r></p></e>
<e>       <p><l><s n="n"/><s n="xsup"/></l>  <r><s n="n"/><s n="xsup"/></r></p></e>
    </pardef>
    <pardef n="adj:adj_sint" c="synthetic on nor side; xpst:xpsts and let transfer deal with xcomp/xsup">
<e>       <p><l><s n="adj"/></l>              <r><s n="adj"/><s n="sint"/></r></p><par n="adjgrad"/></e>
<e>       <p><l><s n="n"/><s n="xcomp"/></l> <r><s n="n"/><s n="xcomp"/></r></p></e>
<e>       <p><l><s n="n"/><s n="xpst"/></l>  <r><s n="n"/><s n="xpsts"/></r></p></e>
<e>       <p><l><s n="n"/><s n="xsup"/></l>  <r><s n="n"/><s n="xsup"/></r></p></e>
    </pardef>

    <pardef n="adj_sint@pst" c="synthetic on both sides, restrict to positive">
<e>       <p><l><s n="adj"/><s n="sint"/><s n="pst"/></l> <r><s n="adj"/><s n="sint"/><s n="pst"/></r></p></e>
<e>       <p><l><s n="adj"/><s n="sint"/><s n="pst"/><s n="ut"/><s n="sg"/><s n="ind"/></l> <r><s n="adj"/><s n="sint"/><s n="pst"/><s n="mf"/><s n="sg"/><s n="ind"/></r></p></e>
<e r="RL"><p><l><s n="adj"/><s n="sint"/><s n="pst"/><s n="ut"/><s n="sg"/><s n="ind"/></l> <r><s n="adj"/><s n="sint"/><s n="pst"/><s n="f"/><s n="sg"/><s n="ind"/></r></p></e>
<e>       <p><l><s n="adj"/><s n="sint"/><s n="pst"/><s n="un"/><s n="sp"/><s n="def"/></l> <r><s n="adj"/><s n="sint"/><s n="pst"/><s n="un"/><s n="sp"/><s n="def"/></r></p></e>
<e>       <p><l><s n="n"/><s n="xpsts"/></l> <r><s n="n"/><s n="xpsts"/></r></p></e>
    </pardef>

    <pardef n="adj_ord" c="ordinals">
<e>       <p><l><s n="adj"/><s n="ord"/></l> <r><s n="adj"/><s n="ord"/></r></p><par n="adjgrad"/></e>
<e>       <p><l><s n="n"/><s n="xpsto"/></l> <r><s n="n"/><s n="xpsto"/></r></p></e>
    </pardef>


<pardef n="A-Å.">
  <e>       <p><l>A.</l>     <r>A.</r></p></e>
