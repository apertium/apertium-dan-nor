  <!-- For https://github.com/apertium/organisation/issues/10: -->
  <e r="LR"><p><l>AP_PAIR_VERSION<s n="adv"/></l><r>@APERTIUM_AUTO_VERSION@<s n="adv"/></r></p></e>
  <e r="RL"><p><l>@APERTIUM_AUTO_VERSION@<s n="adv"/></l><r>AP_PAIR_VERSION<s n="adv"/></r></p></e>
  <e>       <re>AP_LANG_VERSION[@0-9a-z_=/\+]+</re><p><l><s n="adv"/></l><r><s n="adv"/></r></p></e>
  
</section>

<section id="regex" type="standard">
  <!-- a-z* regexes lead to blow-up (2M → 15M) when in main section, keep them here: -->

  <!-- G20, V75 etc. -->
  <e>       <re>[A-ZÆØÅ]+\-?[0-9][0-9A-ZÆØÅ]*</re><p><l><s n="n"/><s n="m"/></l><r><s n="n"/><s n="m"/></r></p></e>
  <e>       <re>[A-Z]</re><i><s n="np"/></i></e>
  <e>       <re>[A-Z]S</re><i><s n="np"/></i></e>  <!-- since A-Z<gen> matches "AS" and generates "As" -->

  <!-- Initials: H.C. Andersen -->
  <e>       <par n="A-Å."/><p><l><s n="np"/></l><r><s n="np"/></r></p></e>
  <e>       <par n="A-Å."/><par n="A-Å."/><p><l><s n="np"/></l><r><s n="np"/></r></p></e>
  <e>       <par n="A-Å."/><par n="A-Å."/><par n="A-Å."/><p><l><s n="np"/></l><r><s n="np"/></r></p></e>

  <e>       <par n="letter"/><p><l>alphabet<s n="n"/><s n="m"/></l><r>alphabet<s n="n"/><s n="m"/></r></p></e>

  <e> <re>[A-ZÆØÅ]+[a-zæøå]*\-</re><p><l>baseret</l>                    <r>basert</r></p><par n="adj"/></e>
  <e> <re>[A-ZÆØÅ]+[a-zæøå]*\-</re><p><l>ulykke<s n="n"/><s n="ut"/></l><r>ulykke<s n="n"/></r></p><par n=":f/m"/></e>

  <e>       <re>[0-9]+</re><p><l>-årig</l><r>-årig</r></p><par n="adj"/></e>

  <!-- For generating forms that were "analysed" by CG -->
  <e lm="np cgguess regex"><par n="lowerdash+"/><par n="cgguess__np"/></e>

  <!-- For analysing name-compound-parts ending in dash (letting the second part be looked up in .dix, something CG can't do): -->
  <!-- not using letter pardefs since that makes the final transducer huge -->
  <e lm="np-guio guess regex"> <re>[A-ZÆØÅ][a-zæøå]+\-</re> <p><l><s n="np"/><s n="guess"/></l> <r><s n="np"/><s n="guess"/></r></p></e>
  <!-- avoid lttoolbox#167: -->
  <!--  <e lm="np-guio guess regex"> <re>[A-ZÆØÅ][A-ZÆØÅ]+\-</re> <p><l><s n="np"/><s n="guess"/></l> <r><s n="np"/><s n="guess"/></r></p></e> -->

<!-- <e>         <par n="cardinals"/> <p><l><b/>år<b/>lang</l> <r><b/>år<b/>lang</r></p><par n="adj"/></e> -->
<!-- <e vr="nno"><par n="cardinals"/> <p><l><b/>år<b/>gammel</l> <r><b/>år<b/>gammal</r></p><par n="adj_sint"/></e> -->
<!-- <e vr="nob"><par n="cardinals"/> <p><l><b/>år<b/>gammel</l> <r><b/>år<b/>gammel</r></p><par n="adj_sint"/></e> -->
<!-- <e>       <par n="ein-hundre"/><i>–</i><par n="ein-hundre"/><i><s n="det"/><s n="qnt"/></i></e> -->
  
  <!-- Numbers are *not* in inconditional, since that would block compounding with them: -->
  <e><re>[0-9]+[\-][0-9]+</re><p><l><s n="det"/><s n="qnt"/></l><r><s n="det"/><s n="qnt"/></r></p></e>
  <e><re>[0-9]+([.,][0-9]+)*( ?%)?</re><p><l><s n="det"/><s n="qnt"/></l><r><s n="det"/><s n="qnt"/></r></p></e>
  <e><re>[0-9]+([., ][0-9]+)* tusen</re><p><l><s n="det"/><s n="qnt"/></l><r><s n="det"/><s n="qnt"/></r></p></e>
  <e vr="nno"><re>[0-9]+([., ][0-9]+)* [mb]illi(on|ard)</re><p><l>er<s n="det"/><s n="qnt"/></l><r>ar<s n="det"/><s n="qnt"/></r></p></e>
  <e vr="nob"><re>[0-9]+([., ][0-9]+)* [mb]illi(on|ard)</re><p><l>er<s n="det"/><s n="qnt"/></l><r>er<s n="det"/><s n="qnt"/></r></p></e>
  <e><p><l>.<s n="sent"/><s n="clb"/><s n="remspc"/></l><r>.<s n="sent"/><s n="clb"/><s n="remspc"/></r></p></e>

  <!-- To get things like «MAX 8-fly» as two tokens instead of four (though one would be even better): -->
  <e c="2-3-seier"> <re>[0-9]([.0-9–\-]*[0-9])?</re><par n="n_cmp_only"/></e>
  
  <!-- 22.30-tiden needs a non-compund entry, otherwise it gets tokenised
         as 22.<adj><ord>-<guio>tid<n> since the adj.ord are inconditional:-->
  <e><re>[0-9]+[.][0-9]+</re><p><l>-tid<s n="n"/><s n="m"/></l><r>-tid<s n="n"/></r></p><par n=":f/m"/></e>
  <e><re>[0-9]+[.]</re><p><l>-plass<s n="n"/><s n="m"/></l><r>-plass<s n="n"/><s n="m"/></r></p></e>
  <e><re>[0-9]+[.]</re><p><l>-klassing<s n="n"/><s n="m"/></l><r>-klassing<s n="n"/><s n="m"/></r></p></e>
  <e><re>[0-9]+[.]</re><p><l>-omgang<s n="n"/><s n="m"/></l><r>-omgang<s n="n"/><s n="m"/></r></p></e>
  <e><re>[0-9]+[.]</re><p><l>-divisjon<s n="n"/><s n="m"/></l><r>-divisjon<s n="n"/><s n="m"/></r></p></e>
  <e><re>[0-9]+[.]</re><p><l>-divisjonsavdeling<s n="n"/><s n="f"/></l><r>-divisjonsavdeling<s n="n"/></r></p><par n=":f/m"/></e>
  <e><re>[0-9]+[.]</re><p><l>-lag<s n="n"/><s n="nt"/></l><r>-lag<s n="n"/><s n="nt"/></r></p></e>
  <e vr="nno"><re>[0-9–—\-]+</re><p><l><b/>måneders<b/>alder<s n="n"/><s n="ut"/></l><r>-månadersalder<s n="n"/><s n="m"/></r></p></e>
  <e vr="nob"><re>[0-9–—\-]+</re><p><l><b/>måneders<b/>alder<s n="n"/><s n="ut"/></l><r>-månedersalder<s n="n"/><s n="m"/></r></p></e>
  <!-- And a non-compound (but cmp-tagged) entry for the general case to analyse
         things like «1.000-kroneseddel» as ^1.<n><cmp>$^000<n><cmp>$^seddel<n>$,
         but without using the compound machinery (which would be overridden by inconditionals): -->
  <e c="0-9+."> <re>[0-9]+[.]</re><par n="n_cmp_only"/></e>
  
  <e lm="foo.com"> <re>(https?://)?(www.)?([a-zæøå0-9\-_]+[.])+(com|no|net|co[.]uk|fr|se|biz|dk|gov|org|nz|uk|eu)+(/[a-zæøå0-9\-_/]*)?</re><p><l><s n="url"/></l><r><s n="url"/></r></p></e>

</section>

  <section id="final" type="inconditional">

<e><re>[.\?;:!…¿¶]</re><p><l><s n="sent"/></l><r><s n="sent"/></r></p></e>
<e><re>[½¹²³¼¾]</re><p><l><s n="det"/><s n="qnt"/></l><r><s n="det"/><s n="qnt"/></r></p></e>
<e>       <p><l>..<s n="sent"/></l><r>..<s n="sent"/></r></p></e>
<e>       <p><l>...<s n="sent"/></l><r>...<s n="sent"/></r></p></e>
<e>       <p><l>'<s n="apos"/></l><r>’<s n="apos"/></r></p></e>
<e>       <p><l>«<s n="lquot"/></l><r>«<s n="lquot"/></r></p></e>
<e>       <p><l>»<s n="rquot"/></l><r>»<s n="rquot"/></r></p></e>
<e><re>[,/]</re><p><l><s n="cm"/></l><r><s n="cm"/></r></p></e>
<e>       <p><l>-<s n="guio"/></l><r>-<s n="guio"/></r></p></e>
<e>       <p><l>_@<s n="guio"/></l><r>_@<s n="guio"/></r></p></e>
<e>       <p><l>@<s n="guio"/></l><r>@<s n="guio"/></r></p></e>
<e c="en dash"><i>–</i><p><l><s n="guio"/></l><r><s n="guio"/></r></p></e>
<e c="em dash"><i>—</i><p><l><s n="guio"/></l><r><s n="guio"/></r></p></e>
<e><re>[\(\[{]</re><p><l><s n="lpar"/></l><r><s n="lpar"/></r></p></e>
<e><re>[\)\]}]</re><p><l><s n="rpar"/></l><r><s n="rpar"/></r></p></e>

<e><re>[0-9]+</re><p><l>.</l><r>.</r></p><par n="adj_ord"/></e>

<e r="LR"><p><l>❡<s n="sent"/></l><r></r></p></e>
<e r="RL"><p><l></l>              <r>❡<s n="sent"/></r></p></e>
  </section>

</dictionary>
